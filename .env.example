# You can also fill this in from the browser (gear icon, top right). Never commit your real .env.
TAPO_HOST=192.168.0.50
TAPO_SUBNET=192.168.0
TAPO_USER=camera_account_user
TAPO_PASSWORD=camera_account_password
TAPO_CLOUD_PASSWORD=tp_link_account_password
# optional
# TAPO_DATA_DIR=/mnt/d/tapo          where videos and analysis results are stored
# TAPO_ANALYZE_AUTO=1                analyse every new clip in the background
# TAPO_ANALYZE_KEEP=all              all | animals | none
# TAPO_WEB_HOST=127.0.0.1
# TAPO_WEB_PORT=8088
